```python
import importlib, sys, subprocess

def ensure(pkg, import_name=None, version_spec=""):
    name = import_name or pkg
    try:
        importlib.import_module(name)
        print(f"OK: {name} já instalado.")
    except ImportError:
        print(f"Instalando {pkg}{version_spec}...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", f"{pkg}{version_spec}"])

ensure("pandas")
ensure("numpy")
ensure("matplotlib")
```

